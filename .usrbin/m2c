#!/usr/bin/env python3
import argparse
import re
import base64
import mimetypes
from pathlib import Path
import urllib.parse
import sys
import html

# Regex for Markdown images: ![alt](url)
IMG_MD_RE = re.compile(r'!\[([^\]]*)\]\(([^)]+)\)')

def is_url(path: str):
    """Return True if the path is an external URL or data URI."""
    scheme = urllib.parse.urlparse(path).scheme
    return scheme in ('http', 'https', 'data')

def embed_images_inline(md_text: str, md_path: Path):
    """Replace local Markdown images with inline HTML <img> tags.

    Behavior:
    - Leaves `http(s):` and `data:` URIs alone.
    - Resolves relative and absolute local paths and encodes them
      as `data:<mime>;base64,...` inline images (Colab-friendly).
    - If the target is `attachment:NAME`, attempts to find `NAME`
      next to the markdown file and inline it.
    - HTML-escapes the `alt` text to avoid breaking attributes.
    """

    def repl(m):
        alt = m.group(1)
        target = m.group(2).strip()

        # Extract actual path (strip optional title)
        target_token = target.split()[0]

        # Remove enclosing <...>
        if target_token.startswith('<') and target_token.endswith('>'):
            target_token = target_token[1:-1]

        # If it's an external URL or a data URI, leave it alone
        if is_url(target_token):
            return m.group(0)

        # Support targets of the form "attachment:filename"
        if target_token.startswith('attachment:'):
            _, fname = target_token.split(':', 1)
            img_path = (md_path.parent / fname).resolve()
        else:
            # If an absolute path was provided, use it; otherwise resolve relative
            p = Path(target_token)
            img_path = p.resolve() if p.is_absolute() else (md_path.parent / target_token).resolve()

        # If the straightforward resolution failed, try ancestors of the markdown
        # file's directory. Log all attempted paths.
        attempted_paths = [str(img_path)]
        found = False
        if not img_path.exists():
            for ancestor in (md_path.parent, *md_path.parents):
                # Try direct ancestor/filename
                candidate = (ancestor / target_token).resolve()
                attempted_paths.append(str(candidate))
                if candidate.exists():
                    img_path = candidate
                    found = True
                    break
                # Try ancestor/img/filename
                img_candidate = (ancestor / "img" / Path(target_token).name).resolve()
                attempted_paths.append(str(img_candidate))
                if img_candidate.exists():
                    img_path = img_candidate
                    found = True
                    break
            if not found:
                print(f"warning: image not found. Tried paths:", file=sys.stderr)
                for p in attempted_paths:
                    print(f"  {p}", file=sys.stderr)
                return m.group(0)

        # Guess MIME type
        mime, _ = mimetypes.guess_type(str(img_path))
        if mime is None:
            mime = "application/octet-stream"

        # Read file + encode base64
        b64 = base64.b64encode(img_path.read_bytes()).decode("ascii")

        # HTML-escape the alt text to be safe inside attributes
        safe_alt = html.escape(alt, quote=True)

        # Build inline HTML (Colab-friendly)
        html_tag = f'<img alt="{safe_alt}" src="data:{mime};base64,{b64}" />'

        return html_tag

    new_md = IMG_MD_RE.sub(repl, md_text)
    return new_md

def process_markdown(in_file: Path, out_file: Path):
    md_text = in_file.read_text(encoding="utf-8")
    new_md = embed_images_inline(md_text, in_file)
    # If the requested output is a notebook, extract each base64 image into
    # a separate markdown cell (Colab-friendly, easy to view/manage images).
    if out_file.suffix == '.ipynb':
        import json

        cells = []
        
        # Split markdown by HTML img tags to separate text and images
        # Pattern: <img alt="..." src="data:..." />
        img_pattern = re.compile(r'(<img [^>]*src="data:[^"]*"[^>]*/?>)')
        parts = img_pattern.split(new_md)
        
        for part in parts:
            if not part.strip():
                # Skip empty parts
                continue
            
            if part.startswith('<img'):
                # This is an image tag; put it in its own markdown cell
                lines = [part.strip() + '\n']
                cells.append({
                    "cell_type": "markdown",
                    "metadata": {"language": "markdown"},
                    "source": lines
                })
            else:
                # This is text; put it in a markdown cell
                lines = [ln + '\n' for ln in part.splitlines() if ln.strip()]
                if lines:
                    cells.append({
                        "cell_type": "markdown",
                        "metadata": {"language": "markdown"},
                        "source": lines
                    })
        
        nb = {
            "cells": cells,
            "metadata": {},
            "nbformat": 4,
            "nbformat_minor": 5
        }

        out_file.write_text(json.dumps(nb, ensure_ascii=False, indent=2), encoding="utf-8")
        print(f"Wrote notebook {out_file}")
    else:
        out_file.write_text(new_md, encoding="utf-8")
        print(f"Wrote {out_file}")

def main():
    p = argparse.ArgumentParser(description="Convert Markdown images to inline HTML base64 for Google Colab.")
    p.add_argument("md", help="input markdown file")
    p.add_argument("out", nargs="?", help="output markdown file")
    args = p.parse_args()

    in_path = Path(args.md)
    if not in_path.exists():
        print("Input markdown file not found.", file=sys.stderr)
        sys.exit(2)

    out_path = Path(args.out) if args.out else in_path.with_suffix(".ipynb")
    process_markdown(in_path, out_path)

if __name__ == "__main__":
    main()