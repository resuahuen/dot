#!/usr/bin/env python3

import sys
import os
import re
import genanki
from pathlib import Path
import base64
import shutil
import argparse


def convert_latex(md):
    md = re.sub(r'\$\$(.+?)\$\$', r'\\[\1\\]', md, flags=re.DOTALL)
    md = re.sub(r'\$(.+?)\$', r'\\(\1\\)', md)
    return md


def extract_image_paths(md):
    return set(re.findall(r'!\[.*?\]\((.*?)\)', md))


def image_to_base64(path):
    with open(path, 'rb') as f:
        return base64.b64encode(f.read()).decode('utf-8')


def image_to_data_uri(path):
    try:
        b64 = image_to_base64(path)
        import mimetypes
        mime, _ = mimetypes.guess_type(str(path))
        if not mime:
            mime = 'application/octet-stream'
        return f'data:{mime};base64,{b64}'
    except Exception:
        return None


def replace_images_with_anki(md, media_sources):
    def repl(match):
        path = match.group(1)
        src = media_sources.get(path, path)
        datauri = None
        try:
            if src and Path(src).exists():
                datauri = image_to_data_uri(src)
        except TypeError:
            datauri = None
        if datauri:
            return f'<img src="{datauri}">'
        filename = Path(path).name
        return f'<img src="{filename}">'

    return re.sub(r'!\[.*?\]\((.*?)\)', repl, md)


def parse_cards(md):
    cards = []
    for block in md.split('%kk'):
        block = block.strip()
        if not block:
            continue
        parts = re.split(r'\s*%\s*', block, maxsplit=1)
        if len(parts) < 2:
            continue
        front = parts[0].strip()
        back = parts[1].strip()
        back_parts = re.split(r'\s*%\s*', back, maxsplit=1)
        back = back_parts[0].strip()
        if front and back:
            cards.append((front, back))
    return cards


def find_media_source(md_dir: Path, orig_ref: str, verbose=False):
    p = Path(orig_ref)
    if p.is_absolute():
        if p.exists():
            return str(p.resolve())
        return None
    candidate = (md_dir / p)
    if candidate.exists():
        return str(candidate.resolve())
    basename = p.name
    if verbose:
        print(f"Looking up basename '{basename}' under {md_dir}")
    for f in md_dir.rglob(basename):
        if f.is_file():
            if verbose:
                print(f"Found media for {orig_ref} at {f}")
            return str(f.resolve())
    return None


def find_cfg_root(start_path: Path) -> Path | None:
    p = start_path
    if p.is_file():
        p = p.parent
    for parent in [p] + list(p.parents):
        cfg = parent / 'anx.cfg'
        if cfg.exists():
            return parent
    return None


def replace_images_with_basename(md_text: str):
    def repl(match):
        path = match.group(1)
        filename = Path(path).name
        return f'<img src="{filename}">'
    return re.sub(r'!\[.*?\]\((.*?)\)', repl, md_text)


def process_files(md_files, output_apkg, verbose=False, search_all=False, base_root: Path | None = None):
    # Build decks keyed by hierarchical deck name
    deck_map: dict[str, genanki.Deck] = {}
    model = genanki.Model(
        1607392319,
        'Simple Model',
        fields=[{'name': 'Front'}, {'name': 'Back'}],
        templates=[{
            'name': 'Card 1',
            'qfmt': '{{Front}}',
            'afmt': '{{FrontSide}}<hr id="answer">{{Back}}',
        }],
    )

    media_map: dict[str, str | None] = {}
    media_list: list[str] = []
    seen_basenames: set[str] = set()

    for md_path in md_files:
        mdp = Path(md_path)
        if verbose:
            print(f"Processing {mdp}")
        text = mdp.read_text(encoding='utf-8')
        text = convert_latex(text)
        cards = parse_cards(text)
        md_dir = mdp.parent

        # determine deck name using provided base_root (preferred), then nearest anx.cfg
        cfg_root = find_cfg_root(mdp)
        parts = []
        if base_root:
            try:
                rel = md_dir.relative_to(base_root)
                parts = [base_root.name] + list(rel.parts)
            except Exception:
                parts = []
        if not parts:
            try:
                if cfg_root:
                    rel = md_dir.relative_to(cfg_root)
                    parts = [cfg_root.name] + list(rel.parts)
                else:
                    parts = list(md_dir.parts)
            except Exception:
                parts = list(md_dir.parts)

        # create decks per-directory under the anx.cfg root.
        # Do NOT append the markdown filename so all files in a directory
        # share the same deck (e.g., 009sem::mos).
        parts = [p for p in parts if p]
        deck_name = '::'.join(parts) if parts else mdp.parent.stem
        deck_id = abs(hash(str(cfg_root) + deck_name)) % (2 ** 31 - 1)
        if deck_name not in deck_map:
            deck_map[deck_name] = genanki.Deck(deck_id, deck_name)

        # discover media refs and resolve sources
        media_refs = set()
        for front, back in cards:
            media_refs |= extract_image_paths(front)
            media_refs |= extract_image_paths(back)

        for ref in media_refs:
            if ref in media_map:
                continue
            src = find_media_source(md_dir, ref, verbose=verbose if search_all else False)
            media_map[ref] = src
            if src and Path(src).exists():
                b = Path(src).name
                if b not in seen_basenames:
                    seen_basenames.add(b)
                    media_list.append(str(src))
                    if verbose:
                        print(f"Including media: {src} (reference {ref})")
                else:
                    if verbose:
                        print(f"Skipping duplicate media basename {b} from {src}")
            else:
                if verbose:
                    print(f"Not including media for {ref} (not found)")

        # add notes to deck
        for front, back in cards:
            front_html = replace_images_with_basename(front)
            back_html = replace_images_with_basename(back)
            note = genanki.Note(model=model, fields=[front_html, back_html])
            deck_map[deck_name].add_note(note)

    if not deck_map:
        print("No cards found; skipping .apkg creation.")
        return

    # build package with all decks
    decks = list(deck_map.values())
    package = genanki.Package(decks)
    if media_list:
        package.media_files = media_list

    import tempfile
    out_tmp = Path(tempfile.mktemp(prefix='m2a_') )
    package.write_to_file(str(out_tmp))
    shutil.move(str(out_tmp), output_apkg)
    print(f"Wrote {output_apkg} with {sum(len(d.notes) for d in decks)} cards and {len(media_list)} media files")


def process_directory(dir_path, verbose=False, search_all=False):
    dir_path = Path(dir_path)
    if search_all:
        md_iter = sorted(dir_path.rglob('*.md'))
        if verbose:
            print(f"Recursively scanning {dir_path} for .md files")
    else:
        md_iter = sorted(dir_path.glob('*.md'))
        if verbose:
            print(f"Scanning {dir_path} for top-level .md files")
    for mdfile in md_iter:
        out_apkg = mdfile.with_suffix('.apkg')
        if verbose:
            print(f"Processing {mdfile} -> {out_apkg}")
        process_files([str(mdfile)], str(out_apkg), verbose=verbose, search_all=search_all)


def main():
    parser = argparse.ArgumentParser(
        description="Convert markdown(s) to an Anki .apkg deck. Supports images and LaTeX.",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    parser.add_argument('input_md', nargs='?', default=None, help='Input markdown file or directory (default: current dir)')
    parser.add_argument('output_apkg', nargs='?', help='Output .apkg file (default: derived from input)')
    parser.add_argument('--dir', action='store_true', help='Treat input as directory (scan for .md files)')
    parser.add_argument('--all', action='store_true', help='When used with --dir, search recursively for .md files and for image basenames')
    parser.add_argument('-v', '--verbose', action='store_true', help='Enable verbose output')
    args = parser.parse_args()
    input_arg = args.input_md
    if input_arg is None:
        input_arg = '.' if args.dir else '.'
    p = Path(input_arg)
    if args.dir or p.is_dir():
        if not p.exists():
            print(f"Error: directory {p} does not exist", file=sys.stderr)
            sys.exit(1)
        if args.all:
            md_files = [str(x) for x in p.rglob('*.md') if x.is_file()]
        else:
            md_files = [str(x) for x in p.glob('*.md') if x.is_file()]
        if not md_files:
            print(f"No markdown files found in {p}")
            return
        if args.output_apkg:
            output = args.output_apkg
        else:
            output = str(p.resolve().name) + '.apkg'
    else:
        if not p.exists():
            print(f"Error: file {p} does not exist", file=sys.stderr)
            sys.exit(1)
        md_files = [str(p)]
        if args.output_apkg:
            output = args.output_apkg
        else:
            base = os.path.splitext(str(p))[0]
            output = base + '.apkg'
    # Determine base_root: when --all is used with input '.' or when input equals cwd,
    # use cwd as the parent deck name per requested behaviour.
    base_root = None
    try:
        if args.all and (str(p.resolve()) == str(Path.cwd().resolve()) or input_arg in ('.', None)):
            base_root = Path.cwd()
    except Exception:
        base_root = None

    process_files(md_files, output, verbose=args.verbose, search_all=args.all, base_root=base_root)


if __name__ == '__main__':
    main()
