#!/usr/bin/env python3

import sys
import os
import re
import genanki
from pathlib import Path
import base64
import shutil
import argparse


def convert_latex(md):
    # Convert $$...$$ to \[...\]
    md = re.sub(r'\$\$(.+?)\$\$', r'\\[\1\\]', md, flags=re.DOTALL)
    # Convert $...$ to \(...\)
    md = re.sub(r'\$(.+?)\$', r'\\(\1\\)', md)
    return md


def extract_image_paths(md):
    # Find all ![alt](path) and return set of paths
    return set(re.findall(r'!\[.*?\]\((.*?)\)', md))


def image_to_base64(path):
    with open(path, 'rb') as f:
        return base64.b64encode(f.read()).decode('utf-8')


def image_to_data_uri(path):
    """Return a data URI for the image file at path, or None if not readable."""
    try:
        b64 = image_to_base64(path)
        import mimetypes
        mime, _ = mimetypes.guess_type(str(path))
        if not mime:
            mime = 'application/octet-stream'
        return f'data:{mime};base64,{b64}'
    except Exception:
        return None


def replace_images_with_anki(md, media_sources):
    # Replace ![alt](path) with an <img src="data:..."> data URI when possible.
    def repl(match):
        path = match.group(1)
        src = media_sources.get(path, path)
        datauri = None
        try:
            if Path(src).exists():
                datauri = image_to_data_uri(src)
        except TypeError:
            # src might be None or not a path-like
            datauri = None
        if datauri:
            return f'<img src="{datauri}">'
        # fallback: use the basename as before
        filename = Path(path).name
        return f'<img src="{filename}">'

    return re.sub(r'!\[.*?\]\((.*?)\)', repl, md)


def parse_cards(md):
    cards = []
    for block in md.split('%kk'):
        block = block.strip()
        if not block:
            continue
        # Split on first '%'
        parts = re.split(r'\s*%\s*', block, maxsplit=1)
        if len(parts) < 2:
            continue  # skip if not both delimiters present
        front = parts[0].strip()
        back = parts[1].strip()
        # Split back again at the next '%', if present
        back_parts = re.split(r'\s*%\s*', back, maxsplit=1)
        back = back_parts[0].strip()
        if front and back:
            cards.append((front, back))
    return cards



def main(md_path, output_apkg, verbose=False, search_all=False):
    md_path = Path(md_path)
    if verbose:
        print(f"Reading markdown file: {md_path}")
    with open(md_path, encoding='utf-8') as f:
        md = f.read()

    md = convert_latex(md)
    cards = parse_cards(md)
    if verbose:
        print(f"Found {len(cards)} cards.")

    # If there are no cards, do not produce an .apkg file.
    if not cards:
        if verbose:
            print(f"No cards found in {md_path}; skipping .apkg creation.")
        else:
            print(f"No cards in {md_path}; skipping.")
        return

    media_files = {}
    media_sources = {}
    all_media = set()
    for front, back in cards:
        all_media |= extract_image_paths(front)
        all_media |= extract_image_paths(back)

    md_dir = md_path.parent
    for path in all_media:
        # Resolve image path relative to the markdown file when not absolute
        orig_ref = path
        p = Path(path)
        found = None
        if p.is_absolute():
            if p.exists():
                found = p
        else:
            candidate = md_dir / p
            if candidate.exists():
                found = candidate
            else:
                # Optionally, search recursively by basename in md_dir when requested
                if search_all:
                    basename = p.name
                    matches = list(md_dir.rglob(basename))
                    if matches:
                        found = matches[0]
        media_files[orig_ref] = Path(orig_ref).name
        media_sources[orig_ref] = str(found) if found else None
        if verbose and not found:
            print(f"Warning: Media file not found for reference '{orig_ref}'; attempted relative path and basename search")

    model = genanki.Model(
        1607392319,
        'Simple Model',
        fields=[{'name': 'Front'}, {'name': 'Back'}],
        templates=[{
            'name': 'Card 1',
            'qfmt': '{{Front}}',
            'afmt': '{{Back}}',
        }],
    )

    deck = genanki.Deck(2059400110, 'My Deck')
    media_list = []

    for i, (front, back) in enumerate(cards, 1):
        front_html = replace_images_with_anki(front, media_sources)
        back_html = replace_images_with_anki(back, media_sources)
        deck.add_note(genanki.Note(model=model, fields=[front_html, back_html]))
        if verbose:
            print(f"Added card {i}: Front length {len(front_html)}, Back length {len(back_html)}")
            front_imgs = list(extract_image_paths(front))
            back_imgs = list(extract_image_paths(back))
            if front_imgs:
                print(f"  Images on front: {', '.join(front_imgs)}")
            if back_imgs:
                print(f"  Images on back: {', '.join(back_imgs)}")

    for orig_ref, fname in media_files.items():
        src = media_sources.get(orig_ref)
        if src and Path(src).exists():
            media_list.append(src)
            if verbose:
                print(f"Including media: {src} (referenced as {orig_ref})")
        else:
            if verbose:
                print(f"Skipping media inclusion for {orig_ref}; source not found")

    import tempfile
    tf = tempfile.NamedTemporaryFile(prefix='m2a_', suffix='.apkg', delete=False)
    tf.close()
    local_output = tf.name
    genanki.Package(deck, media_files=media_list).write_to_file(local_output)
    if verbose:
        print(f"Deck written to temporary file {local_output}")
    shutil.move(local_output, output_apkg)
    print(f"Deck moved to {output_apkg}")


def process_directory(dir_path, verbose=False, search_all=False):
    dir_path = Path(dir_path)
    if search_all:
        md_iter = sorted(dir_path.rglob('*.md'))
        if verbose:
            print(f"Recursively scanning {dir_path} for .md files")
    else:
        md_iter = sorted(dir_path.glob('*.md'))
        if verbose:
            print(f"Scanning {dir_path} for top-level .md files")

    for mdfile in md_iter:
        out_apkg = mdfile.with_suffix('.apkg')
        if verbose:
            print(f"Processing {mdfile} -> {out_apkg}")
        main(mdfile, out_apkg, verbose=verbose, search_all=search_all)


if __name__ == '__main__':
    parser = argparse.ArgumentParser(
        description="Convert markdown with %kk/% delimiters to an Anki .apkg deck. Supports images and LaTeX.",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter
    )
    parser.add_argument('input_md', nargs='?', help='Input markdown file or directory')
    parser.add_argument('output_apkg', nargs='?', help='Output .apkg file (default: same name as input)')
    parser.add_argument('-v', '--verbose', action='store_true', help='Enable verbose output')
    parser.add_argument('--dir', action='store_true', help='Process a directory of markdown files')
    parser.add_argument('--all', action='store_true', help='Search recursively for image basenames when paths are missing')
    args = parser.parse_args()

    if not args.input_md:
        parser.error('input_md is required (file or directory)')

    if args.dir:
        process_directory(args.input_md, verbose=args.verbose, search_all=args.all)
    else:
        input_md = args.input_md
        if args.output_apkg:
            output_apkg = args.output_apkg
        else:
            base = os.path.splitext(input_md)[0]
            output_apkg = base + '.apkg'

        main(input_md, output_apkg, verbose=args.verbose, search_all=args.all)